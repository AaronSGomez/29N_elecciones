# ==============================================================================
# 29N_ELECCIONES — GITIGNORE ESTRICTO (SEGURIDAD & SECRETOS)
# ==============================================================================

# Secretos y variables de entorno (NUNCA versionar .env real)
.env
.env.*
!.env.example

# Datos vectoriales y documentos locales
qdrant_storage*/
ingestion/data/*.pdf
ingestion/data/*.PDF
*.sqlite
*.db

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs y temporales
*.log
logs/
tmp/
.DS_Store
Thumbs.db

# Configuraciones generadas en despliegue
deploy/nginx/*.conf
!deploy/nginx/*.conf.template
