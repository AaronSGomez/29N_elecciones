# ==============================================================================
# 29N ELECCIONES — VHOST NGINX INDEPENDIENTE (conf.d/29n_elecciones.conf)
# No modifica odoo_ai_proxy.conf ni los 4 subdominios existentes.
# ==============================================================================

limit_req_zone $binary_remote_addr zone=limit_29n:10m rate=${NGINX_RATE_LIMIT_RPS};

upstream backend_29n_upstream {
    server backend_29n:${APP_PORT};
    keepalive 16;
}

server {
    listen 80;
    server_name ${DOMAIN_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Bloqueo de bots y escáneres comunes
    if ($http_user_agent ~* (curl|wget|python-requests|nikto|sqlmap|nmap|masscan|zgrab|gobuster|dirbuster|scrapy|semrush|ahrefs|mj12bot)) {
        return 403;
    }

    location ~* ^/(wp-|wordpress|\.env|\.git|.*\.php|boaform|ubus|SDK|info\.php|site\.zip|.*\.sql) {
        return 444;
    }

    location /api/chat {
        limit_req zone=limit_29n burst=${NGINX_BURST} nodelay;
        proxy_pass http://backend_29n_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streaming SSE sin buffering
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }

    location / {
        limit_req zone=limit_29n burst=20 nodelay;
        proxy_pass http://backend_29n_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
