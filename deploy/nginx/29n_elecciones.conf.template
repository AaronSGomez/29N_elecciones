# ==============================================================================
# 29N ELECCIONES — VHOST NGINX HTTPS INDEPENDIENTE (conf.d/29n_elecciones.conf)
# No modifica odoo_ai_proxy.conf ni los 4 subdominios existentes.
# ==============================================================================

limit_req_zone $binary_remote_addr zone=limit_29n:10m rate=${NGINX_RATE_LIMIT_RPS};

upstream backend_29n_upstream {
    server backend_29n:${APP_PORT};
    keepalive 16;
}

server {
    listen 80;
    server_name ${DOMAIN_NAME};

    # Bloqueo inmediato en puerto 80 de dotfiles y rutas de exploit sin redirigir a HTTPS
    location ~ /\.(?!well-known) {
        return 444;
    }

    location ~* ^/(wp-|wordpress|xmlrpc|wlwmanifest|\.env|\.git|\.svn|\.hg|\.kube|\.docker|\.npmrc|.*\.php|boaform|ubus|SDK|owa|rpc/|ReportServer|developmentserver|\+CSCOE\+|cgi-bin|admin|login|vpn|sellers\.json|gcp-key|api/session|Public/home|static/admin|cap\.js|Dr0v|site\.zip|.*\.sql) {
        return 444;
    }

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN_NAME};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Whitelist temporal de IPs / Acceso público
    ${NGINX_ALLOW_RULES}

    # Permitir únicamente métodos HTTP legítimos de la aplicación
    if ($request_method !~ ^(GET|HEAD|POST)$) {
        return 444;
    }

    # Bloqueo de bots maliciosos, fuzzers y escáneres de vulnerabilidades
    if ($http_user_agent ~* (curl|wget|python-requests|python-httpx|go-http-client|nikto|sqlmap|nmap|masscan|zgrab|zmap|gobuster|dirbuster|scrapy|semrush|ahrefs|mj12bot|censys|cortex-xpanse|visionheight|genomecrawler|cyberconvoy|modatscanner|cms-checker|internetdata|cyber-asset-fetch|hello\ world)) {
        return 444;
    }

    # Bloqueo de intentos de evasión por URL encoding de punto/barra (%2e / %2f)
    if ($request_uri ~* "(%2e|%2f%2e|\.\.)") {
        return 444;
    }

    # Bloqueo estricto de cualquier archivo o carpeta oculta (.env, .git, .svn, .kube, etc.)
    location ~ /\.(?!well-known) {
        return 444;
    }

    # Bloqueo de rutas de escaneo y explotación comunes
    location ~* ^/(wp-|wordpress|xmlrpc|wlwmanifest|\.env|\.git|\.svn|\.hg|\.kube|\.docker|\.npmrc|.*\.php|boaform|ubus|SDK|owa|rpc/|ReportServer|developmentserver|\+CSCOE\+|cgi-bin|admin|login|vpn|sellers\.json|gcp-key|api/session|Public/home|static/admin|cap\.js|Dr0v|site\.zip|.*\.sql) {
        return 444;
    }

    location /api/chat {
        limit_req zone=limit_29n burst=${NGINX_BURST} nodelay;
        proxy_pass http://backend_29n_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streaming SSE sin buffering
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }

    location / {
        limit_req zone=limit_29n burst=20 nodelay;
        proxy_pass http://backend_29n_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
