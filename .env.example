# ==============================================================================
# 29N_ELECCIONES — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env y rellena los valores reales.
# PROHIBIDO subir .env a GitHub o hardcodear valores en el código.
# ==============================================================================

# --- Despliegue Raspberry Pi (SSH) ---
PI_HOST=CHANGE_ME_IP_RASPBERRY
PI_PORT=22
PI_USER=CHANGE_ME_USUARIO_PI
PI_PASSWORD=CHANGE_ME_PASSWORD_PI
PI_DEPLOY_DIR=/opt/29n_elecciones

# --- Dominio y Nginx (Host existente en la Pi) ---
DOMAIN_NAME=CHANGE_ME_TU_DOMINIO
NGINX_SITE_NAME=29n_elecciones
NGINX_RATE_LIMIT_RPS=5r/s
NGINX_BURST=10

# --- Aplicación FastAPI (Aislada del otro proyecto) ---
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8029
CORS_ORIGINS=https://CHANGE_ME_TU_DOMINIO
RATE_LIMIT_PER_MIN=20
MAX_QUERY_LENGTH=500
CACHE_TTL_SECONDS=300

# --- Qdrant (Instancia dedicada y aislada en puertos/volumen) ---
QDRANT_HOST=qdrant_29n
QDRANT_PORT=6339
QDRANT_GRPC_PORT=6340
QDRANT_API_KEY=CHANGE_ME_QDRANT_API_KEY
QDRANT_COLLECTION=programas_29n
QDRANT_TOP_K=5
QDRANT_SCORE_THRESHOLD=0.45

# --- Embeddings Locales (FastEmbed ONNX — 0 gasto de API Grok) ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- LLM (Grok API / OpenAI-compatible) ---
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=CHANGE_ME_GROK_API_KEY
LLM_MODEL=grok-3-mini
LLM_MAX_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.1

# --- Bot de Telegram (Opcional / Whitelist familiar) ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_ALLOWED_USER_IDS=CHANGE_ME_COMMA_SEPARATED_IDS

# --- Control de acceso IP temporal en Nginx ---
ALLOWED_CLIENT_IPS=CHANGE_ME_TU_IP_PUBLICA,192.168.0.0/16,127.0.0.1
